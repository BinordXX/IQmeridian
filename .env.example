# Shared platform
NODE_ENV=development

# URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iqmeridian

# Redis
REDIS_URL=redis://localhost:6379

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=iqmeridian-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Auth
AUTH_SECRET=replace_this_with_a_long_random_secret
AUTH_TRUST_HOST=true


# Psychometrics service
PSYCHOMETRICS_SERVICE_URL=http://127.0.0.1:8001
PSYCHOMETRICS_INTERNAL_TOKEN=dev-psychometrics-token
PSYCHOMETRICS_ENVIRONMENT=development
PSYCHOMETRICS_SERVICE_VERSION=0.1.0
PSYCHOMETRICS_PORT=8001
PSYCHOMETRICS_INTERNAL_SERVICE_TOKEN=dev-psychometrics-token
PSYCHOMETRICS_DATA_ACCESS_MODE=nestjs_orchestrated
PSYCHOMETRICS_INTERNAL_API_URL=http://api:3001
PSYCHOMETRICS_OUTPUT_MODE=return_to_nestjs