# Shared platform
NODE_ENV=development

# URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iqmeridian

# Redis
REDIS_URL=redis://localhost:6379

# Object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=iqmeridian-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Auth
AUTH_SECRET=replace_this_with_a_long_random_secret
AUTH_TRUST_HOST=true


PSYCHOMETRICS_SERVICE_URL=http://127.0.0.1:8001
PSYCHOMETRICS_INTERNAL_TOKEN=dev-psychometrics-token