{
  "name": "iqmeridian",
  "version": "1.0.0",
  "private": true,
  "description": "IQMeridian cognitive assessment platform",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "docker:dev:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker/docker-compose.dev.yml logs -f",
    "dev:infra": "docker compose -f docker/docker-compose.dev.yml up -d postgres redis minio psychometrics",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:all": "pnpm dev:infra && concurrently -n API,WEB -c blue,cyan \"pnpm dev:api\" \"pnpm dev:web\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BinordXX/IQmeridian.git"
  },
  "keywords": [],
  "author": "Binord",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/BinordXX/IQmeridian/issues"
  },
  "homepage": "https://github.com/BinordXX/IQmeridian#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
