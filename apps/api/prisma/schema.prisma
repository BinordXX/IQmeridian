generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PLATFORM_ADMIN
  EMPLOYER_ADMIN
  CANDIDATE
  CONSUMER
  RESEARCHER
}

enum PsychometricAnalysisStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum PsychometricFlagEntityType {
  FORM
  DOMAIN
  ITEM
  DISTRACTOR
}

enum PsychometricFlagType {
  TOO_EASY
  TOO_HARD
  WEAK_DISCRIMINATION
  NEGATIVE_DISCRIMINATION
  HIGH_OMISSION
  TOO_SLOW
  TOO_FAST
  WEAK_DISTRACTOR
  OVERATTRACTIVE_DISTRACTOR
  POSSIBLE_AMBIGUITY
  POSSIBLE_ANSWER_KEY_ISSUE
  LOW_DOMAIN_SPREAD
  LOW_FORM_RELIABILITY
  LOW_SCORE_SPREAD
}

enum PsychometricFlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum PsychometricFlagReviewStatus {
  OPEN
  ACCEPTED
  DISMISSED
  NEEDS_REVISION
  RESOLVED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum AssessmentDomain {
  VERBAL_REASONING
  NUMERICAL_REASONING
  ABSTRACT_REASONING
  LOGICAL_REASONING
  ANALYTICAL_PROBLEM_SOLVING
}

enum AssessmentSectionType {
  VERBAL
  NUMERICAL
  ABSTRACT
  LOGICAL
  ANALYTICAL
}

enum ItemStatus {
  DRAFT
  ACTIVE
  RETIRED
  UNDER_REVIEW
}

enum ItemIntendedDifficulty {
  EASY
  MODERATE
  HARD
  VERY_HARD
}

enum ItemReviewStatus {
  NOT_REVIEWED
  REVIEW_IN_PROGRESS
  APPROVED_FOR_PILOT
  NEEDS_REVISION
  REJECTED
}

enum PsychometricItemStatus {
  DRAFT
  CONTENT_REVIEWED
  PILOT_READY
  UNDER_REVIEW
  FLAGGED_AFTER_PILOT
  RETIRED
  CALIBRATED
}

enum PilotFormStatus {
  DRAFT
  READY_FOR_REVIEW
  LOCKED_FOR_PILOT
  ACTIVE_PILOT
  CLOSED
  ARCHIVED
}

enum AnalyticsExportRequestStatus {
  REQUESTED
  APPROVED
  DECLINED
  GENERATING
  GENERATED
  FAILED
  CANCELLED
}

enum SessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  ABANDONED
}

enum ReportVisibility {
  INTERNAL
  EMPLOYER
  CANDIDATE
  CONSUMER
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String?
  role           UserRole
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  auditLogs               AuditLog[]
  sessions                Session[]
  campaignsOwned          Campaign[]               @relation("CampaignOwner")
  reports                 Report[]                 @relation("ReportSubject")
  invitations             Invitation[]             @relation("InvitationCandidate")
  exportRequestsReviewed  AnalyticsExportRequest[] @relation("ExportRequestReviewer")
  exportRequestsRequested AnalyticsExportRequest[] @relation("ExportRequestRequester")
}

model Organisation {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  campaigns Campaign[]
}

model Campaign {
  id               String          @id @default(cuid())
  name             String
  status           CampaignStatus  @default(DRAFT)
  organisationId   String
  organisation     Organisation    @relation(fields: [organisationId], references: [id])
  ownerId          String?
  owner            User?           @relation("CampaignOwner", fields: [ownerId], references: [id])
  assessmentFormId String?
  assessmentForm   AssessmentForm? @relation(fields: [assessmentFormId], references: [id])
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  invitations Invitation[]
  sessions    Session[]
}

model AssessmentForm {
  id           String          @id @default(cuid())
  name         String
  version      Int             @default(1)
  versionLabel String?         @default("v0.1")
  isActive     Boolean         @default(false)
  pilotStatus  PilotFormStatus @default(DRAFT)
  isLocked     Boolean         @default(false)

  domainBlueprint Json?
  timingRules     Json?
  scoringVersion  Int   @default(1)
  reportVersion   Int   @default(1)

  lockedAt DateTime?
  lockedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections                 AssessmentSection[]
  items                    FormItemMapping[]
  campaigns                Campaign[]
  sessions                 Session[]
  psychometricAnalysisRuns PsychometricAnalysisRun[]

  @@index([pilotStatus])
  @@index([isLocked])
  @@index([name, version])
}

model AssessmentSection {
  id           String                @id @default(cuid())
  formId       String
  form         AssessmentForm        @relation(fields: [formId], references: [id])
  type         AssessmentSectionType
  domain       AssessmentDomain
  title        String
  timeLimitSec Int
  orderIndex   Int

  items          FormItemMapping[]
  activeSessions Session[]         @relation("CurrentSessionSection")
}

model Item {
  id            String           @id @default(cuid())
  domain        AssessmentDomain
  prompt        String
  itemType      String
  options       Json?
  correctAnswer Json?
  scoringRule   String?          @default("BINARY_CORRECT")
  difficulty    String?
  status        ItemStatus       @default(DRAFT)
  version       Int              @default(1)

  subdomain                String?
  itemFamily               String?
  stimulusType             String?
  intendedDifficulty       ItemIntendedDifficulty?
  estimatedResponseTimeSec Int?
  cognitiveProcess         String?
  itemRationale            String?
  distractorRationale      Json?
  reviewStatus             ItemReviewStatus        @default(NOT_REVIEWED)
  psychometricStatus       PsychometricItemStatus  @default(DRAFT)
  lastReviewedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formMappings FormItemMapping[]
  responses    Response[]

  psychometricMetrics ItemPsychometricMetric[]
  distractorMetrics   DistractorPsychometricMetric[]
  psychometricFlags   PsychometricFlag[]
}

model FormItemMapping {
  id         String                @id @default(cuid())
  formId     String
  form       AssessmentForm        @relation(fields: [formId], references: [id])
  sectionId  String?
  section    AssessmentSection?    @relation(fields: [sectionId], references: [id])
  itemId     String
  item       Item                  @relation(fields: [itemId], references: [id])
  orderIndex Int
  status     FormItemMappingStatus @default(ACTIVE)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@unique([formId, itemId])
}

model Invitation {
  id              String           @id @default(cuid())
  campaignId      String
  campaign        Campaign         @relation(fields: [campaignId], references: [id])
  email           String
  token           String           @unique
  status          InvitationStatus @default(PENDING)
  candidateUserId String?
  candidateUser   User?            @relation("InvitationCandidate", fields: [candidateUserId], references: [id])
  createdAt       DateTime         @default(now())
  expiresAt       DateTime?
  usedAt          DateTime?

  sessions Session[]
}

model Session {
  id                         String             @id @default(cuid())
  userId                     String
  user                       User               @relation(fields: [userId], references: [id])
  campaignId                 String?
  campaign                   Campaign?          @relation(fields: [campaignId], references: [id])
  invitationId               String?
  invitation                 Invitation?        @relation(fields: [invitationId], references: [id])
  assessmentFormId           String
  assessmentForm             AssessmentForm     @relation(fields: [assessmentFormId], references: [id])
  assessmentFormVersion      Int                @default(1)
  assessmentFormVersionLabel String?
  scoringVersion             Int                @default(1)
  reportVersion              Int                @default(1)
  formSnapshot               Json?
  status                     SessionStatus      @default(NOT_STARTED)
  startedAt                  DateTime?
  completedAt                DateTime?
  currentSectionId           String?
  currentSection             AssessmentSection? @relation("CurrentSessionSection", fields: [currentSectionId], references: [id])
  currentSectionOrder        Int?
  sectionStartedAt           DateTime?
  sectionEndsAt              DateTime?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  responses Response[]
  score     Score?
  report    Report[]
}

model Response {
  id          String    @id @default(cuid())
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  answer      Json?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([sessionId, itemId])
  @@index([sessionId])
  @@index([itemId])
}

model Score {
  id        String  @id @default(cuid())
  sessionId String  @unique
  session   Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  abstractRawScore  Int?
  abstractMaxScore  Int?
  numericalRawScore Int?
  numericalMaxScore Int?
  overallRawScore   Int?
  overallMaxScore   Int?
  overallComposite  Float?

  abstractBand  String?
  numericalBand String?
  overallBand   String?

  domainScores    Json?
  scoringMetadata Json?
  scoringVersion  Int   @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id            String           @id @default(cuid())
  sessionId     String
  session       Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  scoreId       String?
  scoreSnapshot Json?
  subjectUserId String?
  subjectUser   User?            @relation("ReportSubject", fields: [subjectUserId], references: [id])
  visibility    ReportVisibility
  summary       Json?
  metadata      Json?
  reportVersion Int              @default(1)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([sessionId, visibility])
  @@index([sessionId])
  @@index([subjectUserId])
  @@index([visibility])
}

model PsychometricAnalysisRun {
  id String @id @default(cuid())

  formId String?
  form   AssessmentForm? @relation(fields: [formId], references: [id], onDelete: SetNull)

  formVersion    Int?
  scoringVersion Int?
  reportVersion  Int?

  datasetScope   Json?
  status         PsychometricAnalysisStatus @default(PENDING)
  serviceVersion String

  sampleSize   Int?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  itemMetrics       ItemPsychometricMetric[]
  formMetrics       FormPsychometricMetric[]
  domainMetrics     DomainPsychometricMetric[]
  distractorMetrics DistractorPsychometricMetric[]
  flags             PsychometricFlag[]

  @@index([formId])
  @@index([status])
  @@index([startedAt])
}

model ItemPsychometricMetric {
  id String @id @default(cuid())

  analysisRunId String
  analysisRun   PsychometricAnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  domain             AssessmentDomain
  subdomain          String?
  itemFamily         String?
  intendedDifficulty String?

  responseCount     Int    @default(0)
  correctCount      Int    @default(0)
  proportionCorrect Float?

  averageResponseTimeSec Float?
  medianResponseTimeSec  Float?

  omissionRate        Float?
  discriminationValue Float?

  flags String[] @default([])

  createdAt DateTime @default(now())

  @@unique([analysisRunId, itemId])
  @@index([itemId])
  @@index([domain])
}

model FormPsychometricMetric {
  id String @id @default(cuid())

  analysisRunId String
  analysisRun   PsychometricAnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  totalSessions     Int @default(0)
  completedSessions Int @default(0)

  completionRate Float?

  meanTotalScore    Float?
  medianTotalScore  Float?
  standardDeviation Float?
  minimumScore      Float?
  maximumScore      Float?

  reliabilityEstimate Float?

  averageCompletionTimeSec Float?
  scoreDistributionSummary Json?

  createdAt DateTime @default(now())

  @@unique([analysisRunId])
}

model DomainPsychometricMetric {
  id String @id @default(cuid())

  analysisRunId String
  analysisRun   PsychometricAnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  domain AssessmentDomain

  itemCount     Int @default(0)
  responseCount Int @default(0)

  meanScore   Float?
  scoreSpread Float?

  omissionRate           Float?
  averageResponseTimeSec Float?
  reliabilityEstimate    Float?

  createdAt DateTime @default(now())

  @@unique([analysisRunId, domain])
  @@index([domain])
}

model DistractorPsychometricMetric {
  id String @id @default(cuid())

  analysisRunId String
  analysisRun   PsychometricAnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  optionKey   String
  optionLabel String?

  selectionCount      Int    @default(0)
  selectionPercentage Float?

  highPerformerSelectionRate Float?
  lowPerformerSelectionRate  Float?

  isCorrectOption Boolean @default(false)

  flags String[] @default([])

  createdAt DateTime @default(now())

  @@unique([analysisRunId, itemId, optionKey])
  @@index([itemId])
  @@index([analysisRunId])
}

model PsychometricFlag {
  id String @id @default(cuid())

  analysisRunId String
  analysisRun   PsychometricAnalysisRun @relation(fields: [analysisRunId], references: [id], onDelete: Cascade)

  entityType PsychometricFlagEntityType
  flagType   PsychometricFlagType
  severity   PsychometricFlagSeverity     @default(MEDIUM)
  status     PsychometricFlagReviewStatus @default(OPEN)

  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)

  domain    AssessmentDomain?
  optionKey String?

  message  String
  evidence Json?

  reviewedBy String?
  reviewedAt DateTime?
  reviewNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([analysisRunId])
  @@index([itemId])
  @@index([entityType])
  @@index([flagType])
  @@index([severity])
  @@index([status])
}

model AnalyticsExportRequest {
  id     String                       @id @default(cuid())
  status AnalyticsExportRequestStatus @default(REQUESTED)

  dataset String
  format  String

  dateFrom DateTime?
  dateTo   DateTime?
  scope    Json?

  requestedById String?
  requestedBy   User?   @relation("ExportRequestRequester", fields: [requestedById], references: [id])
  requestedRole String?
  requestReason String?

  reviewedById   String?
  reviewedBy     User?     @relation("ExportRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewDecision String?
  reviewReason   String?

  generatedAt   DateTime?
  fileKey       String?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([dataset])
  @@index([requestedById])
  @@index([reviewedById])
  @@index([createdAt])
}

model AnalyticsExportGovernanceSetting {
  id               String  @id @default("default")
  approvalRequired Boolean @default(true)
  updatedByRole    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])
}

enum FormItemMappingStatus {
  ACTIVE
  INACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}
